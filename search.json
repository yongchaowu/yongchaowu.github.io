---
---
[
{% for post in site.posts %}
{% include topic-for-post.html post=post %}
{% assign search_editorial = nil %}
{% assign search_editorial_path = post.path | split: '_posts/' | last | prepend: '_posts/' %}
{% for item in site.data.post_editorial.posts %}
    {% if item.post == search_editorial_path %}{% assign search_editorial = item %}{% endif %}
{% endfor %}
{% assign search_content_type = search_editorial.content_type | default: site.data.post_editorial.defaults.content_type %}
{% assign search_placement = search_editorial.placement | default: site.data.post_editorial.defaults.placement %}
{% assign search_freshness = search_editorial.freshness | default: site.data.post_editorial.defaults.freshness %}
{% assign search_verification = search_editorial.verification | default: site.data.post_editorial.defaults.verification %}
{% assign search_risk = search_editorial.risk | default: site.data.post_editorial.defaults.risk %}
{% assign search_origin = search_editorial.origin | default: site.data.post_editorial.defaults.origin %}
{% assign search_series = search_editorial.series %}
{% assign search_text = post.content | strip_html | normalize_whitespace %}
{% assign search_text = search_text | replace: '&lt;', '<' %}
{% assign search_text = search_text | replace: '&gt;', '>' %}
{% assign search_text = search_text | replace: '&quot;', '"' %}
{% assign search_text = search_text | replace: '&#39;', "'" %}
{% assign search_text = search_text | replace: '&#x27;', "'" %}
{% assign search_text = search_text | replace: '&amp;', '&' %}
{
"title": {{ post.title | jsonify }},
"display_title": {{ post.display_title | default: post.title | jsonify }},
"url": {{ post.url | jsonify }},
"date": "{{ post.date | date: '%F' }}",
"topic": {{ canonical_topic | default: post.categories.first | jsonify }},
"categories": {{ post.categories | jsonify }},
"tags": {{ post.tags | jsonify }},
"curated": {{ post.curated | default: false | jsonify }},
"content_origin": {{ post.content_origin | jsonify }},
"content_type": {{ search_content_type | jsonify }},
"placement": {{ search_placement | jsonify }},
"freshness": {{ search_freshness | jsonify }},
"verification": {{ search_verification | jsonify }},
"risk": {{ search_risk | jsonify }},
"origin": {{ search_origin | jsonify }},
"attribution": {{ search_editorial.attribution | jsonify }},
"series": {{ search_series | jsonify }},
"text": {{ search_text | jsonify }}
}{% unless forloop.last %},{% endunless %}
{% endfor %}
]
